# Locate miniBill app files on fnOS and extract app.tgz when needed.

# Emit existing /volN/@appdata/<app> or /volN/@appcenter/<app> dirs (N may vary).
list_vol_app_dirs() {
    local kind="$1" # appdata | appcenter
    local d
    # shellcheck disable=SC2086
    for d in /vol*/@"${kind}"/${TRIM_APPNAME} /usr/local/apps/@"${kind}"/${TRIM_APPNAME}; do
        if [ -d "$d" ]; then
            echo "$d"
        fi
    done
}

resolve_pkgvar() {
    if [ -n "${TRIM_PKGVAR:-}" ]; then
        echo "${TRIM_PKGVAR}"
        return 0
    fi
    local d first=""
    if [ -n "${TRIM_APPNAME:-}" ]; then
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            if [ -z "$first" ]; then
                first="$d"
            fi
            # Prefer the data dir that already has a live system DB.
            if [ -f "${d}/data/system.db" ]; then
                echo "$d"
                return 0
            fi
        done <<EOF
$(list_vol_app_dirs appdata)
EOF
        if [ -n "$first" ]; then
            echo "$first"
            return 0
        fi
        # Prefer first existing vol; fallback keeps historical default for fresh install.
        echo "/vol1/@appdata/${TRIM_APPNAME}"
        return 0
    fi
    echo ""
}

resolve_runtime_paths() {
    local pkgvar
    pkgvar="$(resolve_pkgvar)"
    ENV_FILE="${pkgvar}/minibill.env"
    PID_FILE="${pkgvar}/minibill.pid"
    LOG_FILE="${pkgvar}/minibill.log"
    DATA_DIR="${pkgvar}/data"
}

resolve_app_dest() {
    local d
    if [ -n "${TRIM_APPDEST:-}" ] && [ -d "${TRIM_APPDEST}" ]; then
        echo "${TRIM_APPDEST}"
        return 0
    fi
    if [ -n "${TRIM_APPNAME:-}" ]; then
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            echo "$d"
            return 0
        done <<EOF
$(list_vol_app_dirs appcenter)
EOF
        if [ -d "/var/apps/${TRIM_APPNAME}" ]; then
            echo "/var/apps/${TRIM_APPNAME}"
            return 0
        fi
    fi
    if [ -n "${TRIM_APPDEST:-}" ]; then
        echo "${TRIM_APPDEST}"
        return 0
    fi
    echo "/var/apps/${TRIM_APPNAME}"
}

# Sets APP_ROOT and APP_BIN. Returns 0 on success.
ensure_app_ready() {
    local dest tgz
    dest="$(resolve_app_dest)"
    tgz="${dest}/app.tgz"

    if [ -x "${dest}/app/bin/minibill" ]; then
        APP_ROOT="${dest}/app"
        APP_BIN="${APP_ROOT}/bin/minibill"
        return 0
    fi

    if [ -x "${dest}/bin/minibill" ]; then
        APP_ROOT="${dest}"
        APP_BIN="${dest}/bin/minibill"
        return 0
    fi

    if [ ! -f "$tgz" ]; then
        return 1
    fi

    mkdir -p "${dest}/app"
    tar -xzf "$tgz" -C "${dest}/app"
    chmod +x "${dest}/app/bin/minibill" "${dest}/app/bin/reset-password" 2>/dev/null || true

    if [ -x "${dest}/app/bin/minibill" ]; then
        APP_ROOT="${dest}/app"
        APP_BIN="${APP_ROOT}/bin/minibill"
        return 0
    fi

    tar -xzf "$tgz" -C "${dest}"
    chmod +x "${dest}/bin/minibill" "${dest}/bin/reset-password" 2>/dev/null || true
    if [ -x "${dest}/bin/minibill" ]; then
        APP_ROOT="${dest}"
        APP_BIN="${dest}/bin/minibill"
        return 0
    fi

    return 1
}

app_ui_config() {
    local dest root
    dest="$(resolve_app_dest)"
    for root in "${dest}/app/ui/config" "${dest}/ui/config"; do
        if [ -f "$root" ]; then
            echo "$root"
            return 0
        fi
    done
    echo "${dest}/app/ui/config"
}
