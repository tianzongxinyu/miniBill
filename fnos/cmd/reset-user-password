#!/bin/bash
# Reset a user's password on fnOS using packaged paths.
# Usage:
#   reset-user-password <username> <newpassword>
#   reset-user-password -username alice -password newsecret

set -euo pipefail

TRIM_APPNAME="${TRIM_APPNAME:-minibill}"
. "$(dirname "$0")/app-layout"

APP_ROOT=""
APP_BIN=""
if ! ensure_app_ready; then
    echo "未找到轻账单安装目录（已扫描 /vol*/@appcenter/${TRIM_APPNAME}）" >&2
    exit 1
fi
resolve_runtime_paths

RESET_BIN="${APP_ROOT}/bin/reset-password"
if [ ! -x "$RESET_BIN" ]; then
    echo "未找到 reset-password：$RESET_BIN（请升级到含该工具的版本）" >&2
    exit 1
fi

if [ ! -d "$DATA_DIR" ]; then
    echo "数据目录不存在：$DATA_DIR（已扫描 /vol*/@appdata/${TRIM_APPNAME}/data）" >&2
    exit 1
fi

echo "using APP_ROOT=$APP_ROOT DATA_DIR=$DATA_DIR" >&2

export DATA_DIR
export MIGRATIONS_SYSTEM="${APP_ROOT}/migrations/system"
export MIGRATIONS_LEDGER="${APP_ROOT}/migrations/ledger"

if [ "$#" -eq 2 ] && [ "${1#-}" = "$1" ]; then
    exec "$RESET_BIN" -username "$1" -password "$2"
fi
if [ "$#" -eq 0 ]; then
    echo "usage: reset-user-password <username> <newpassword>" >&2
    echo "   or: reset-user-password -username alice -password newsecret" >&2
    exit 1
fi
exec "$RESET_BIN" "$@"
